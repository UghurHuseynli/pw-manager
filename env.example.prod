# Prod profile — copy to .env.prod on the production host and fill in.
# Loaded when ENVIRONMENT=prod (docker-compose.yml sets this by default).
# Generate fresh SECRET_KEY/FERNET_KEY for prod — never reuse dev's.
SECRET_KEY=change-me
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pw-manager
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=change-me@example.com
FIRST_SUPERUSER_PASSWORD=change-me
FRONTEND_URL=https://change-me.example.com
BACKEND_CORS_ORIGINS=https://change-me.example.com
SMTP_HOST=smtp.gmail.com
SMTP_USER=change-me@example.com
SMTP_PASSWORD=change-me
EMAILS_FROM_EMAIL=change-me@example.com
TEST_USER_EMAIL=change-me@example.com
TEST_USER_PASSWORD=change-me
FERNET_KEY=change-me
POSTGRES_TEST_SERVER=db
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_USER=change-me
POSTGRES_TEST_PASSWORD=change-me
POSTGRES_TEST_DB=pw-manager-test
