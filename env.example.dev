# Dev profile — copy to .env.dev and fill in.
# Loaded when ENVIRONMENT=dev (the default — see app/core/config.py).
SECRET_KEY=example
# Docker Compose overrides this to "db" automatically (see docker-compose.yml
# / docker-compose.dev.yml). Use "localhost" (or wherever Postgres actually
# runs) when running the app outside Docker.
POSTGRES_SERVER=example
POSTGRES_PORT=5432
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example
FIRST_SUPERUSER_USERNAME=example
FIRST_SUPERUSER_EMAIL=example@gmail.com
FIRST_SUPERUSER_PASSWORD=example
FRONTEND_URL=http://localhost:3000
# http://localhost:8081 is the Expo web dev server (frontend/) — needed for
# browser fetches from `npx expo start --web` to pass CORS.
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:8081
SMTP_HOST=smtp.gmail.com
SMTP_USER=example@gmail.com
SMTP_PASSWORD=example
EMAILS_FROM_EMAIL=info@example.com
TEST_USER_EMAIL=example.com
TEST_USER_PASSWORD=example
FERNET_KEY=example
POSTGRES_TEST_SERVER=example
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_USER=example
POSTGRES_TEST_PASSWORD=example
POSTGRES_TEST_DB=example
