# Test profile — copy to .env.test and fill in.
# Loaded when ENVIRONMENT=test (e.g. `ENVIRONMENT=test uv run pytest`, or a
# CI pipeline). Not required for everyday `uv run pytest` — that defaults to
# ENVIRONMENT=dev and uses .env.dev's POSTGRES_TEST_* fields, same as before
# this profile system existed. Use this one when you want tests to run
# against a database fully separate from your dev DB.
SECRET_KEY=example
POSTGRES_SERVER=example
POSTGRES_PORT=5432
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example
FIRST_SUPERUSER_USERNAME=example
FIRST_SUPERUSER_EMAIL=example@gmail.com
FIRST_SUPERUSER_PASSWORD=example
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8000
SMTP_HOST=smtp.gmail.com
SMTP_USER=example@gmail.com
SMTP_PASSWORD=example
EMAILS_FROM_EMAIL=info@example.com
TEST_USER_EMAIL=example.com
TEST_USER_PASSWORD=example
FERNET_KEY=example
POSTGRES_TEST_SERVER=example
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_USER=example
POSTGRES_TEST_PASSWORD=example
POSTGRES_TEST_DB=example
